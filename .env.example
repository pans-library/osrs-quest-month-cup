# Copy to .env and fill in. Never commit .env.

# Secret path segment for the Dink webhook: https://<your-host>/hook/<WEBHOOK_TOKEN>
# Generate with: openssl rand -hex 24
WEBHOOK_TOKEN=replace-me-with-a-long-random-string

# Organiser key for adding players and quests in the page.
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=replace-me-with-a-different-long-random-string

# Quest completions before this time are ignored (UTC, ISO 8601).
CUP_START=2026-11-01T00:00:00Z

# Optional: fix the scoring scheme. linear, standard, dynamic, or JSON such as
# {"mode":"custom","points":[12,6,4,3,2],"after":1}. Leave empty to choose it in the scoring lab.
SCORING=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker install command).
TUNNEL_TOKEN=
